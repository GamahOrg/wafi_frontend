{
  "files.autoSave": "afterDelay",
  "editor.formatOnSave": true,
  "editor.fontLigatures": "'cv01', 'cv02', 'cv06', 'ss01', 'zero', 'cv14', 'cv27','cv31','ss10'",
  "editor.fontWeight": "450",
  "editor.fontFamily": "'Fira Code', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "editor.fontSize": 15,
  "editor.semanticHighlighting.enabled": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontFamily": "'Fira Code', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "terminal.integrated.fontLigatures.featureSettings": "'cv01', 'cv02', 'cv06', 'ss01', 'zero', 'cv14', 'cv27','cv31','ss10'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "450",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "application.experimental.rendererProfiling": false,
  "workbench.colorTheme": "Atom One Dark",
  "files.exclude": {
    "**/.mypy_cache": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    ".ruff*": true,
    ".run": true,
    ".dockerignore": true,
    ".next": true,
    "node_modules": true,
    ".idea": true
  },
  "workbench.iconTheme": "vscode-icons",
  "eslint.options": {
    "overrideConfigFile": "eslint.config.mjs"
  },
  "eslint.useFlatConfig": true
}
